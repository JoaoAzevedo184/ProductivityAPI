# ============================================================
# Template de variáveis de ambiente para o docker-compose.yml
# ============================================================

# ----------------------------------------------------------
# PostgreSQL — usado pelo container do Postgres
# ----------------------------------------------------------
DB_NAME=productivity
DB_USER=productivity
DB_PASSWORD=changeme

# ----------------------------------------------------------
# Conexão da API com o Postgres
# ----------------------------------------------------------
# DB_HOST: nome do serviço dentro da network do compose.
#   - "postgres" quando rodando via docker compose (DNS interno)
#   - "host.docker.internal" se a API roda em container e o banco no host
#   - IP ou hostname externo se usar Postgres gerenciado (Neon, Supabase, RDS)
DB_HOST=postgres
DB_PORT=5432

# DB_URL: string JDBC completa. Permite trocar de banco sem mexer no compose.
#   Para Postgres externo, basta substituir esta linha por uma URL completa,
#   por exemplo: jdbc:postgresql://meudb.neon.tech:5432/productivity?sslmode=require
DB_URL=jdbc:postgresql://postgres:5432/productivity

# ----------------------------------------------------------
# JVM
# ----------------------------------------------------------
JAVA_OPTS=-Xms256m -Xmx512m
